# Marvolo — configuration
#
# Copy to ~/.config/marvolo/env (chmod 600) or export these in your shell.
# The app reads the environment first, then that file. No key is ever written to
# the repo, printed in logs, or stored inside a note.

# Handwriting recognition for the "transcribe" button. Required for that button
# only; capture works without it.
DEEPSEEK_API_KEY=

# How transcribe reads a page:
#   vision (default)  the page image goes to a vision model with an instruction, so it
#                     reads words in context ("Prueba", not "Prenda"). ~3-5 s per page.
#   ocr               the document OCR endpoint, which takes no prompt at all: faster
#                     and cheaper, but it reads glyphs and misreads ambiguous letters.
# MARVOLO_OCR_MODE=vision

# The n8n (or any) webhook that stores a captured note: page.png, page.svg, and
# a "meta" field with page number, stroke and point counts, session file, and the
# transcript if one exists. Leave empty to keep notes local only.
MARVOLO_WEBHOOK_URL=

# Optional shared secret, sent as "Authorization: Bearer <token>". Check it in n8n.
MARVOLO_WEBHOOK_TOKEN=

# Optional overrides.
# MARVOLO_OCR_MODEL=deepseek-flash
# MARVOLO_CHAT_ENDPOINT=https://api.deepseek.com/chat/completions
# MARVOLO_OCR_ENDPOINT=https://api.deepseek.com/v1/tools/ocr
# MARVOLO_NOTES_DIR=~/Documents/Marvolo notes
# NOTELIVE_CAPTURE_DIR=~/Library/Application Support/Marvolo/captures
